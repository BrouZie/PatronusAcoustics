build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/brouzie/Projects/personal/PatronusAcoustics/NUCLEOH723ZG/build/Debug && /usr/bin/ccmake -S/home/brouzie/Projects/personal/PatronusAcoustics/NUCLEOH723ZG -B/home/brouzie/Projects/personal/PatronusAcoustics/NUCLEOH723ZG/build/Debug
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
