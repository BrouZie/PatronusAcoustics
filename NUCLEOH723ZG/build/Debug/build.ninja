# Link the executable usart_echo.elf

build usart_echo.elf: C_EXECUTABLE_LINKER__usart_echo_Debug CMakeFiles/NUCLEOH723ZG.dir/Core/Src/main.c.obj CMakeFiles/NUCLEOH723ZG.dir/Core/Src/stm32h7xx_it.c.obj CMakeFiles/NUCLEOH723ZG.dir/Core/Src/stm32h7xx_hal_msp.c.obj CMakeFiles/NUCLEOH723ZG.dir/Core/Src/sysmem.c.obj CMakeFiles/NUCLEOH723ZG.dir/Core/Src/syscalls.c.obj CMakeFiles/NUCLEOH723ZG.dir/startup_stm32h723xx.s.obj CMakeFiles/usart_echo.dir/src/apps/usart_echo/app_main.c.obj | libdrivers.a || NUCLEOH723ZG cmake/stm32cubemx/STM32_Drivers libdrivers.a
  CONFIG = Debug
  FLAGS = -mcpu=cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard  -Wall -fdata-sections -ffunction-sections -fstack-usage -O0 -g3
  LINK_FLAGS = -mcpu=cortex-m7 -mfpu=fpv5-d16 -mfloat-abi=hard  -T "/home/brouzie/Projects/personal/PatronusAcoustics/NUCLEOH723ZG/STM32H723xG_flash.ld" --specs=nano.specs -Wl,-Map=NUCLEOH723ZG.map -Wl,--gc-sections -Wl,--print-memory-usage -Wl,-Map=usart_echo.map
  LINK_LIBRARIES = libdrivers.a  -lm
  OBJECT_DIR = CMakeFiles/usart_echo.dir
  POST_BUILD = cd /home/brouzie/Projects/personal/PatronusAcoustics/NUCLEOH723ZG/build/Debug && arm-none-eabi-size /home/brouzie/Projects/personal/PatronusAcoustics/NUCLEOH723ZG/build/Debug/usart_echo.elf && arm-none-eabi-objcopy -O binary /home/brouzie/Projects/personal/PatronusAcoustics/NUCLEOH723ZG/build/Debug/usart_echo.elf usart_echo.bin
  PRE_LINK = :
  TARGET_FILE = usart_echo.elf
  TARGET_PDB = usart_echo.elf.dbg
  TARGET_SUPPORT_DIR = CMakeFiles/usart_echo.dir


#############################################
# Utility command for flash-usart_echo

build flash-usart_echo: phony CMakeFiles/flash-usart_echo usart_echo.elf


#############################################
# Utility command for apps

build apps: phony CMakeFiles/apps usart_echo.elf


