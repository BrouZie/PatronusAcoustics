build CMakeFiles/flash-usart_echo | ${cmake_ninja_workdir}CMakeFiles/flash-usart_echo: CUSTOM_COMMAND usart_echo.elf || NUCLEOH723ZG cmake/stm32cubemx/STM32_Drivers libdrivers.a usart_echo.elf
  COMMAND = cd /home/brouzie/Projects/personal/PatronusAcoustics/NUCLEOH723ZG/build/Debug && openocd -f interface/stlink.cfg -f target/stm32h7x.cfg -c program\ /home/brouzie/Projects/personal/PatronusAcoustics/NUCLEOH723ZG/build/Debug/usart_echo.elf\ verify\ reset\ exit
  DESC = Flashing usart_echo
